{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "circeweb",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Debe coincidir con "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "circeweb" }
  ],
  // Caché de páginas (ISR). Crear con: npx wrangler kv namespace create NEXT_INC_CACHE_KV
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "4ae22dbf910942c099f7f689c01733b9" }
  ],
  // Etiquetas para revalidatePath (botón «Actualizar la web»). Crear con: npx wrangler d1 create circe-witch-cache
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "circe-witch-cache",
      "database_id": "80c6315c-3e4e-4926-b494-d5d1efed8645"
    }
  ],
  // Valores públicos; deben coincidir con .env.production (que es el que se usa al compilar).
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://loshechizosdecirce.com",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Uc8OtbLrEAfB2cQ-Ec2W0A_QoPPbUBl",
    "NEXT_PUBLIC_SUPABASE_URL": "https://zjdzqwjzlqcylefyvjez.supabase.co"
  },
  // Dominios propios: Cloudflare crea el DNS y el certificado al desplegar.
  "routes": [
    { "pattern": "loshechizosdecirce.com", "custom_domain": true },
    { "pattern": "www.loshechizosdecirce.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
